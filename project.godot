; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Arcade Fighter"
config/description="Retro 16-bit pixel-art fighting game: CED vs KROS"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"
Net="*res://scripts/net/net.gd"
Settings="*res://scripts/core/settings.gd"
Music="*res://scripts/core/music.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]

common/max_physics_steps_per_frame=4

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
